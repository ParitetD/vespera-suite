# Ключи API (опциональны; без ключа модуль пропускается с warning)
HIBP_API_KEY=
SERPAPI_KEY=
VK_ACCESS_TOKEN=
NUMVERIFY_API_KEY=

# Прокси (например http://user:pass@host:port)
PROXY_URL=

# Настройки (значения по умолчанию есть и без .env)
RATE_LIMIT_DEFAULT=1.0
REQUEST_TIMEOUT=30.0
LOG_LEVEL=INFO
DB_PATH=./data/vespera.db
HOST=0.0.0.0
PORT=8000

# AI Copilot (OpenAI-совместимый API)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
